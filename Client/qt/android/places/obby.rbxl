local pad = script.Parent
local done = false
pad.Touched:connect(function(hit)
    if done then return end
    local humanoid = hit.Parent:findFirstChild("Humanoid")
    if humanoid == nil then return end
    done = true
    local m = Instance.new("Message")
    m.Text = "You reached the top!"
    m.Parent = game.Workspace
    wait(4)
    m:Remove()
    done = false
end)
</string></Properties></Item></Item><Item class="Part"><Properties><string name="Name">Ramp block</string><int name="BrickColor">106</int><bool name="Anchored">true</bool><token name="shape">1</token><Vector3 name="size"><X>10</X><Y>4</Y><Z>10</Z></Vector3><CoordinateFrame name="CFrame"><X>-30</X><Y>2</Y><Z>20</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame></Properties></Item><Item class="Part"><Properties><string name="Name">Wall</string><int name="BrickColor">199</int><bool name="Anchored">true</bool><token name="shape">1</token><Vector3 name="size"><X>2</X><Y>8</Y><Z>30</Z></Vector3><CoordinateFrame name="CFrame"><X>-30</X><Y>4</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame></Properties></Item><Item class="Part"><Properties><string name="Name">Low step</string><int name="BrickColor">1</int><bool name="Anchored">true</bool><token name="shape">1</token><Vector3 name="size"><X>6</X><Y>1</Y><Z>6</Z></Vector3><CoordinateFrame name="CFrame"><X>-20</X><Y>0.5</Y><Z>20</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame></Properties></Item><Item class="Part"><Properties><string name="Name">High step</string><int name="BrickColor">1</int><bool name="Anchored">true</bool><token name="shape">1</token><Vector3 name="size"><X>4</X><Y>1</Y><Z>6</Z></Vector3><CoordinateFrame name="CFrame"><X>-24</X><Y>1.5</Y><Z>20</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame></Properties></Item></Item><Item class="StarterPack"><Item class="HopperBin"><Properties><string name="Name">Rocket</string><token name="BinType">6</token></Properties></Item><Item class="HopperBin"><Properties><string name="Name">Slingshot</string><token name="BinType">5</token></Properties></Item